{
  "name": "{{PREFIX}} - Scheduled PowerQuery to UAM Alert",
  "description": "Reference pattern: run a PowerQuery on a schedule via the LRQ API and raise a UAM alert when it returns rows. Use when a scheduled detection rule cannot express the detection: LRQ accepts the full query language (datasource, savelookup, unrestricted joins), has far higher intermediate-result limits, and lets every alert field be composed from the result. Replace {{PREFIX}}, {{START_AT}}, {{PQ_QUERY}}, {{ACCOUNT_ID}} and {{SITE_ID}} before import. Requires two connections: the console (Bearer console API token) for the LRQ calls, and the ingest host (Bearer console API token, S1-Scope header) for the alert POST.",
  "actions": [
    {
      "action": {
        "type": "scheduled_trigger",
        "tag": null,
        "connection_id": null,
        "connection_name": null,
        "use_connection_name": false,
        "integration_id": null,
        "state": null,
        "data": {
          "name": "Scheduled Trigger",
          "action_type": "scheduled_trigger",
          "schedule_method": "interval",
          "until": null,
          "max_runs": 1,
          "schedule_value": [
            {
              "schedule_method": "interval",
              "interval_unit": "hours",
              "interval_value": 1,
              "tz": "UTC"
            }
          ],
          "start_at": "{{START_AT}}",
          "start_at_method": "date",
          "ends_on": "never"
        }
      },
      "export_id": 1,
      "connected_to": [{ "target": 2, "custom_handle": null }],
      "parent_action": null
    },
    {
      "action": {
        "type": "http_request",
        "tag": null,
        "connection_id": null,
        "connection_name": "{{CONSOLE_CONNECTION}}",
        "use_connection_name": true,
        "integration_id": null,
        "state": null,
        "data": {
          "name": "Launch LRQ",
          "action_type": "http_request",
          "public_action_id": null,
          "method": "post",
          "url": "{{Connection.protocol}}{{Connection.url}}/sdl/v2/api/queries",
          "url_path": null,
          "url_prefix": null,
          "payload": "{\n  \"queryType\": \"PQ\",\n  \"tenant\": true,\n  \"startTime\": \"{{Function.DELTA_NOW(1)}}\",\n  \"endTime\": \"{{Function.DATETIME_NOW()}}\",\n  \"queryPriority\": \"HIGH\",\n  \"pq\": {\n    \"query\": \"{{PQ_QUERY}}\",\n    \"resultType\": \"TABLE\"\n  }\n}",
          "content_type": "application/json"
        }
      },
      "export_id": 2,
      "connected_to": [{ "target": 3, "custom_handle": null }],
      "parent_action": null
    },
    {
      "action": {
        "type": "variable",
        "tag": null,
        "connection_id": null,
        "connection_name": null,
        "use_connection_name": false,
        "integration_id": null,
        "state": null,
        "data": {
          "name": "Set LRQ Refs",
          "action_type": "variable",
          "variables": [
            {
              "name": "query_id",
              "value": "{{launch-lrq.body.id}}",
              "should_use_as_output": false,
              "is_secret": false
            },
            {
              "name": "forward_tag",
              "value": "{{Function.JQ(launch-lrq.headers, \"to_entries | map(select(.key|ascii_downcase==\\\"x-dataset-query-forward-tag\\\")) | .[0].value\", true)}}",
              "should_use_as_output": false,
              "is_secret": false
            }
          ],
          "variables_scope": "local"
        }
      },
      "export_id": 3,
      "connected_to": [{ "target": 4, "custom_handle": null }],
      "parent_action": null
    },
    {
      "action": {
        "type": "loop",
        "tag": null,
        "connection_id": null,
        "connection_name": null,
        "use_connection_name": false,
        "integration_id": null,
        "state": null,
        "data": {
          "name": "Poll Until Done",
          "action_type": "loop",
          "loop_type": "while",
          "number_of_iterations": "60",
          "object_to_iterate": "",
          "is_parallel": false
        }
      },
      "export_id": 4,
      "connected_to": [{ "target": 5, "custom_handle": "inner" }],
      "parent_action": null
    },
    {
      "action": {
        "type": "http_request",
        "tag": null,
        "connection_id": null,
        "connection_name": "{{CONSOLE_CONNECTION}}",
        "use_connection_name": true,
        "integration_id": null,
        "state": null,
        "data": {
          "name": "Poll LRQ",
          "action_type": "http_request",
          "public_action_id": null,
          "method": "get",
          "url": "{{Connection.protocol}}{{Connection.url}}/sdl/v2/api/queries/{{local_var.query_id}}",
          "url_path": null,
          "url_prefix": null,
          "payload": null,
          "headers": [
            {
              "key": "X-Dataset-Query-Forward-Tag",
              "value": "{{local_var.forward_tag}}"
            }
          ],
          "content_type": "application/json"
        }
      },
      "export_id": 5,
      "connected_to": [{ "target": 6, "custom_handle": null }],
      "parent_action": 4
    },
    {
      "action": {
        "type": "condition",
        "tag": null,
        "connection_id": null,
        "connection_name": null,
        "use_connection_name": false,
        "integration_id": null,
        "state": null,
        "data": {
          "name": "Query Done",
          "action_type": "condition",
          "condition_type": "multi",
          "condition": null,
          "conditions": [
            {
              "input_value": "{{poll-lrq.body.stepsCompleted}}",
              "compared_value": "{{poll-lrq.body.totalSteps}}",
              "comparison_operator": "equals"
            }
          ],
          "conditions_relationship": "and"
        }
      },
      "export_id": 6,
      "connected_to": [
        { "target": 8, "custom_handle": "true" },
        { "target": 7, "custom_handle": "false" }
      ],
      "parent_action": 4
    },
    {
      "action": {
        "type": "delay",
        "tag": null,
        "connection_id": null,
        "connection_name": null,
        "use_connection_name": false,
        "integration_id": null,
        "state": null,
        "data": {
          "name": "Retry Delay",
          "action_type": "delay",
          "time_unit": "seconds",
          "value": 5
        }
      },
      "export_id": 7,
      "connected_to": [],
      "parent_action": 4
    },
    {
      "action": {
        "type": "variable",
        "tag": null,
        "connection_id": null,
        "connection_name": null,
        "use_connection_name": false,
        "integration_id": null,
        "state": null,
        "data": {
          "name": "Set Row Count",
          "action_type": "variable",
          "variables": [
            {
              "name": "rowcount",
              "value": "{{Function.JQ(poll-lrq.body.data.values, \"length\", true)}}",
              "should_use_as_output": false,
              "is_secret": false
            },
            {
              "name": "first_entity",
              "value": "{{Function.JQ(poll-lrq.body.data.values, \".[0][0] // \\\"unknown\\\"\", true)}}",
              "should_use_as_output": false,
              "is_secret": false
            }
          ],
          "variables_scope": "local"
        }
      },
      "export_id": 8,
      "connected_to": [{ "target": 9, "custom_handle": null }],
      "parent_action": 4
    },
    {
      "action": {
        "type": "condition",
        "tag": null,
        "connection_id": null,
        "connection_name": null,
        "use_connection_name": false,
        "integration_id": null,
        "state": null,
        "data": {
          "name": "Any Rows",
          "action_type": "condition",
          "condition_type": "multi",
          "condition": null,
          "conditions": [
            {
              "input_value": "{{local_var.rowcount}}",
              "compared_value": "0",
              "comparison_operator": "greater_than"
            }
          ],
          "conditions_relationship": "and"
        }
      },
      "export_id": 9,
      "connected_to": [
        { "target": 10, "custom_handle": "true" },
        { "target": 11, "custom_handle": "false" }
      ],
      "parent_action": 4
    },
    {
      "action": {
        "type": "http_request",
        "tag": null,
        "connection_id": null,
        "connection_name": "{{INGEST_CONNECTION}}",
        "use_connection_name": true,
        "integration_id": null,
        "state": null,
        "data": {
          "name": "Raise UAM Alert",
          "action_type": "http_request",
          "public_action_id": null,
          "method": "post",
          "url": "{{Connection.protocol}}{{Connection.url}}/v1/alerts",
          "url_path": null,
          "url_prefix": null,
          "headers": [
            {
              "key": "S1-Scope",
              "value": "{{ACCOUNT_ID}}:{{SITE_ID}}"
            }
          ],
          "payload": "{\n  \"finding_info\": {\n    \"title\": \"{{PREFIX}} - scheduled query matched {{local_var.rowcount}} row(s)\",\n    \"desc\": \"Raised by a Hyperautomation flow running the detection query over the LRQ API. First entity: {{local_var.first_entity}}.\",\n    \"uid\": \"{{Function.UUID()}}\",\n    \"related_events\": [\n      {\n        \"metadata\": {\n          \"uid\": \"{{Function.UUID()}}\",\n          \"product\": { \"name\": \"{{PREFIX}}\", \"vendor_name\": \"Hyperautomation\" }\n        },\n        \"class_uid\": 1001,\n        \"severity_id\": 3,\n        \"title\": \"Query match\",\n        \"message\": \"{{local_var.rowcount}} row(s) returned\",\n        \"device\": { \"hostname\": \"{{local_var.first_entity}}\" }\n      }\n    ]\n  },\n  \"severity_id\": 3,\n  \"status_id\": 1,\n  \"time\": \"{{Function.DATETIME_NOW()}}\",\n  \"metadata\": {\n    \"product\": { \"name\": \"{{PREFIX}}\", \"vendor_name\": \"Hyperautomation\" },\n    \"version\": \"1.0.0\"\n  }\n}",
          "content_type": "application/json"
        }
      },
      "export_id": 10,
      "connected_to": [{ "target": 11, "custom_handle": null }],
      "parent_action": 4
    },
    {
      "action": {
        "type": "break_loop",
        "tag": null,
        "connection_id": null,
        "connection_name": null,
        "use_connection_name": false,
        "integration_id": null,
        "state": null,
        "data": {
          "name": "Break When Done",
          "action_type": "break_loop"
        }
      },
      "export_id": 11,
      "connected_to": [],
      "parent_action": 4
    }
  ]
}
